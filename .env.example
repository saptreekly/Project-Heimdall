# Local dev without Docker (default):
DATABASE_URL=sqlite+aiosqlite:///./heimdall.db

# With docker compose up -d:
# DATABASE_URL=postgresql+asyncpg://heimdall:heimdall@localhost:5432/heimdall
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=heimdallgraph
NEO4J_BROWSER_URL=http://localhost:7474

# Default source when ingest omits platform (no credentials needed for hackernews)
DEFAULT_INGESTER=hackernews
ASTROTURF_TSV_PATH=data/astroturf.tsv
AUTO_IMPORT_ASTROTURF=true
TWEET_EVAL_SPLIT=test
MASTODON_INSTANCE_URL=https://mastodon.social

# Reddit (optional — dev portal is painful; skip if blocked)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=heimdall:0.1.0 (by /u/your_reddit_username)

# X/Twitter API v2 — optional; ingestion falls back to mock without keys
X_BEARER_TOKEN=
