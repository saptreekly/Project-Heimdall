# Local dev without Docker (default):
DATABASE_URL=sqlite+aiosqlite:///./heimdall.db

# With docker compose up -d:
# DATABASE_URL=postgresql+asyncpg://heimdall:heimdall@localhost:5432/heimdall
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=heimdallgraph
NEO4J_BROWSER_URL=http://localhost:7474

# Default source when ingest omits platform (no credentials needed for hackernews)
DEFAULT_INGESTER=hackernews
ASTROTURF_TSV_PATH=data/astroturf.tsv
AUTO_IMPORT_ASTROTURF=true
TWEET_EVAL_SPLIT=test
MASTODON_INSTANCE_URL=https://mastodon.social

# Embedding theme clusters (requires pip install -e ".[ml]")
USE_EMBEDDING_THEMES=false
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Twitter-roberta sentiment in outrage pipeline (requires pip install -e ".[ml-hf]")
USE_TRANSFORMER_SENTIMENT=false

# Reddit (optional; dev portal is painful; skip if blocked)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=heimdall:0.1.0 (by /u/your_reddit_username)

# Daily GraphQL budget file (CI uses data/dashboard/x_rate_state.json)
# X_RATE_STATE_PATH=data/dashboard/x_rate_state.json

# X/Twitter session cookies (from browser devtools → Application → Cookies for x.com)
# Also accepts AUTH_TOKEN and CT0 (same names as Research Publications scripts)
X_AUTH_TOKEN=
X_CT0=
# Optional official API v2 bearer (not wired yet)
X_BEARER_TOKEN=

# X ingest guardrails (unofficial GraphQL; keep conservative)
X_INGEST_ENABLED=true
X_MAX_KEYWORDS_PER_INGEST=5
X_MAX_POSTS_PER_INGEST=80
X_MAX_TWEETS_PER_SEARCH=20
X_MIN_SECONDS_BETWEEN_SEARCHES=3
X_MAX_GRAPHQL_REQUESTS_PER_DAY=30
